# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Generate secrets with: openssl rand -hex 32

APP_PORT=8080
APP_URL=http://localhost:8080

DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/gin_app?sslmode=disable

# Required in production: 32+ random bytes. The app refuses to boot without it
# unless ALLOW_INSECURE_JWT=true (local dev only, never in prod).
JWT_SECRET=change-me-to-32-plus-random-bytes
# ALLOW_INSECURE_JWT=true
JWT_TTL_HOURS=24

# Gmail SMTP via app password (https://myaccount.google.com/apppasswords).
# Leave empty to log emails instead of sending (dev/test).
EMAIL_SERVICE=Gmail
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Non-Gmail SMTP:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587

# Comma-separated IPs/CIDRs of proxies/LBs in front of the app.
# Empty = trust none (correct for direct exposure).
# TRUSTED_PROXIES=10.0.0.0/8

# Comma-separated frontend origins allowed to call the API from browsers.
# Empty = no CORS headers emitted.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Per-IP budgets (requests/minute). Override per deploy as needed.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# Database used by the test suite (tests skip if unreachable).
TEST_DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/gin_app_test?sslmode=disable
